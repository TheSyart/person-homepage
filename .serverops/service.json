{
  "version": 2,
  "build": {
    "kind": "image",
    "workflow": "serverops-image.yml"
  },
  "runtime": {
    "kind": "compose",
    "services": [
      {
        "name": "web",
        "image": "ghcr.io/thesyart/person-homepage-web",
        "port": 8080,
        "healthPath": "/",
        "data": []
      },
      {
        "name": "api",
        "image": "ghcr.io/thesyart/person-homepage-api",
        "port": 3081,
        "healthPath": "/api/health",
        "data": [
          {
            "name": "data",
            "target": "/app/data"
          }
        ]
      }
    ]
  }
}
